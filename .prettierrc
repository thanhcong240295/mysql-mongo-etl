{
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "importOrder": [
    "express",
    "mongoose",
    "<THIRD_PARTY_MODULES>",
    "@/?(.*)$",
    "^[./]" 
  ],
  "importOrderSeparation": true, 
  "importOrderSortSpecifiers": true,
  "importOrderParserPlugins": ["typescript", "decorators-legacy"],
  "plugins": [
  ]
}