{
  "env": {
    "node": true,
    "commonjs": true
  },
  "root": true,
  "extends": ["standard-with-typescript", "eslint:recommended", "plugin:prettier/recommended"],
  "overrides": [],
  "parserOptions": {
    "ecmaVersion": "latest",
    "parser": "@typescript-eslint/parser",
    "project": "./tsconfig.json"
  },
  "plugins": [],
  "rules": {
    "@typescript-eslint/explicit-function-return-type": "off"
  }
}
